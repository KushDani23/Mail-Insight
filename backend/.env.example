# ════════════════════════════════════════════════════════════════════════
# AI Mail Analyzer — local development environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ════════════════════════════════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-user>
SPRING_DATASOURCE_PASSWORD=<neon-password>

# ── Google OAuth2 ─────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ── Encryption ────────────────────────────────────────────────────────
# Generate a 32-byte base64 key: openssl rand -base64 32
ENCRYPTION_SECRET=<output-of-openssl-rand-base64-32>

# ── CORS ──────────────────────────────────────────────────────────────
# Local React dev server (Vite default)
FRONTEND_ORIGIN=http://localhost:5173
